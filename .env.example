# Copy to .env for local development. On Render, set these in the dashboard.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?appName=Cluster0
DB_NAME=brainsnack
JWT_SECRET=change-me-to-a-long-random-string
PORT=5050
# Comma-separated emails of accounts allowed to approve submitted quizzes
ADMIN_EMAILS=
# AdMob publisher id (pub-XXXXXXXXXXXXXXXX), used to serve /app-ads.txt
ADMOB_PUBLISHER_ID=
# Shown on the privacy policy and account deletion pages
CONTACT_EMAIL=
